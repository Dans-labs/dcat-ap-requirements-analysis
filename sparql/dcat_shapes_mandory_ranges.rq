PREFIX adms: <http://www.w3.org/ns/adms#>
PREFIX cc: <http://creativecommons.org/ns#>
PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX dcatap: <http://data.europa.eu/r5r#>
PREFIX dcatap_shapes: <https://semiceu.github.io/DCAT-AP/releases/3.0.0/html/shacl/shapes.ttl#>
PREFIX dcatap_ranges: <https://semiceu.github.io/DCAT-AP/releases/3.0.0/html/shacl/range.ttl#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX lcon: <http://www.w3.org/ns/locn#>
PREFIX org: <http://www.w3.org/ns/org#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX odrl: <http://www.w3.org/ns/odrl/2/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX spdx: <http://spdx.org/rdf/terms#>
PREFIX time: <http://www.w3.org/2006/time#>
PREFIX vcard: <http://www.w3.org/2006/vcard/ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

############################
# Query DCAT-AP shacl shape files: shapes.ttl, shapes_recommended.ttl, range.ttl
# in order to obtain, for the classes dcat:Catalog & dcat:DataService
# * their mandatory and recommended properties, range and datatype of those properties
# Note: datatype restrictions are only defined for mandatory properties
############################

SELECT ?class_ ?prop ?req ?type ?range
FROM <https://semiceu.github.io/DCAT-AP/releases/3.0.0/html/shacl/shapes.ttl> 
FROM  <https://semiceu.github.io/DCAT-AP/releases/3.0.0/html/shacl/shapes_recommended.ttl> 
FROM  <https://semiceu.github.io/DCAT-AP/releases/3.0.0/html/shacl/range.ttl> 

WHERE {
        VALUES ?class_ {
            dcat:Catalog
            dcat:DataService
            # dcat:Dataset
        }
    ?shape sh:targetClass ?class_ ;
           sh:property ?b_node .             
    {
        {
            # mandatory prop: sh:severity sh:Violation ; sh:minCount 1
            ?b_node sh:path ?prop ;
                    sh:nodeKind ?type ;
                    sh:severity sh:Violation ;
                    sh:minCount 1 .
            BIND("mandatory" AS ?req)         
            # subquery: get property range    
            {
            ?b_node sh:path ?prop ;
                sh:path ?range .
            }
        }
    }
    UNION
    {
        #recommend prop: sh:severity sh:Warning ; sh:minCount 1 
        ?b_node sh:path ?prop ;
                sh:severity sh:Warning ;  
                sh:minCount 1 .      
        BIND("recommended" AS ?req)     
        # subquery: get property range    
        {
        ?b_node sh:path ?prop ;
            sh:path ?range .
        }
    } 
}
ORDER BY ?class_ ?req ?prop