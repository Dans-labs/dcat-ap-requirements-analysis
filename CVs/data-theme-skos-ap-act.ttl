        euvoc:startDate  "2015-10-01"^^<http://www.w3.org/2001/XMLSchema#date>;
        dct:created      "2024-05-22"^^<http://www.w3.org/2001/XMLSchema#date>;
        rdf:value        "datu kopa, kura aptver enerģētikas jomu, kas raksturojama kā kvantitatīva īpašība, kas vajadzīga, lai veiktu darbu ar priekšmetiem vai tos apsildītu, un kas ietver dzīvu organismu dzīvības elementu un cilvēku civilizācijas darbību"@lv;
        dct:creator      "Publications Office of the European Union";
        euvoc:xlNote     "datu kopa, kura aptver enerģētikas jomu, kas raksturojama kā kvantitatīva īpašība, kas vajadzīga, lai veiktu darbu ar priekšmetiem vai tos apsildītu, un kas ietver dzīvu organismu dzīvības elementu un cilvēku civilizācijas darbību"@lv .

<data-theme/75ceeedded2a26f4670aabd60c0a71e4>
        rdf:type         euvoc:XlNote;
        rdf:type         euvoc:XlNote;
        euvoc:startDate  "2015-10-01"^^<http://www.w3.org/2001/XMLSchema#date>;
        dct:created      "2024-05-22"^^<http://www.w3.org/2001/XMLSchema#date>;
        rdf:value        "téma datového souboru týkající se oblasti energie, charakterizované jako kvantitativní vlastnost nezbytná k výkonu práce na tělesech nebo k ohřevu těles a jako prvek se zásadním významem pro živé organismy a pro fungování lidské civilizace"@cs;
        dct:creator      "Publications Office of the European Union";
        euvoc:xlNote     "téma datového souboru týkající se oblasti energie, charakterizované jako kvantitativní vlastnost nezbytná k výkonu práce na tělesech nebo k ohřevu těles a jako prvek se zásadním významem pro živé organismy a pro fungování lidské civilizace"@cs .

<data-theme/a892c9ea3742dbad86555513980d646f>
        rdf:type         euvoc:XlNote;
        rdf:type         euvoc:XlNote;
        euvoc:startDate  "2015-10-01"^^<http://www.w3.org/2001/XMLSchema#date>;
        dct:created      "2024-05-22"^^<http://www.w3.org/2001/XMLSchema#date>;
        rdf:value        "temat zbioru danych obejmujący dziedzinę energii, zdefiniowaną jako właściwość ilościowa niezbędna do wykonywania prac na przedmiotach lub do ich ogrzewania oraz jako istotny element żywych organizmów i działalności cywilizacji ludzkiej"@pl;
        dct:creator      "Publications Office of the European Union";
        euvoc:xlNote     "temat zbioru danych obejmujący dziedzinę energii, zdefiniowaną jako właściwość ilościowa niezbędna do wykonywania prac na przedmiotach lub do ich ogrzewania oraz jako istotny element żywych organizmów i działalności cywilizacji ludzkiej"@pl .

