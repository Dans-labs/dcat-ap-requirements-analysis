        dct:created      "2024-05-22"^^<http://www.w3.org/2001/XMLSchema#date>;
        rdf:value        "tema podatkovnog skupa koja obuhvaća domenu energije, što je količinsko svojstvo nužno za izvođenje radova na predmetima ili za njihovo grijanje, i neophodna je za žive organizme i funkcioniranje ljudske civilizacije"@hr;
        dct:creator      "Publications Office of the European Union";
        euvoc:xlNote     "tema podatkovnog skupa koja obuhvaća domenu energije, što je količinsko svojstvo nužno za izvođenje radova na predmetima ili za njihovo grijanje, i neophodna je za žive organizme i funkcioniranje ljudske civilizacije"@hr .

<data-theme/866910bde7ec73c0a60e315a3f5982ef>
        rdf:type         euvoc:XlNote;
        rdf:type         euvoc:XlNote;
