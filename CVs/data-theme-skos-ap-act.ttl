<data-theme/382cc0dfc029ae1236ef1ec972396ae9>
        rdf:type         euvoc:XlNote;
        rdf:type         euvoc:XlNote;
        euvoc:startDate  "2015-10-01"^^<http://www.w3.org/2001/XMLSchema#date>;
        dct:created      "2024-05-22"^^<http://www.w3.org/2001/XMLSchema#date>;
        rdf:value        "téma dátového súboru pokrývajúca oblasti obyvateľstva a spoločnosti, pričom obyvateľstvo znamená celkový počet ľudí žijúcich na rôznych geografických úrovniach od miest až po globálnu úroveň, zatiaľ čo spoločnosťou sa označuje skupina jednotlivcov zapojených do nepretržitej sociálnej interakcie na spoločnom území, často na základe rovnakých politických a kultúrnych noriem"@sk;
        dct:creator      "Publications Office of the European Union";
        euvoc:xlNote     "téma dátového súboru pokrývajúca oblasti obyvateľstva a spoločnosti, pričom obyvateľstvo znamená celkový počet ľudí žijúcich na rôznych geografických úrovniach od miest až po globálnu úroveň, zatiaľ čo spoločnosťou sa označuje skupina jednotlivcov zapojených do nepretržitej sociálnej interakcie na spoločnom území, často na základe rovnakých politických a kultúrnych noriem"@sk .

<data-theme/293cae2546d6b412208a6965df7ba2be>
        rdf:type         euvoc:XlNote;
        rdf:type         euvoc:XlNote;
        euvoc:startDate  "2015-10-01"^^<http://www.w3.org/2001/XMLSchema#date>;
        dct:created      "2024-05-22"^^<http://www.w3.org/2001/XMLSchema#date>;
        rdf:value        "θέμα συνόλου δεδομένων το οποίο καλύπτει τους τομείς του πληθυσμού και της κοινωνίας, όπου ο πληθυσμός αναφέρεται στον συνολικό αριθμό ατόμων που διαμένουν σε διάφορα γεωγραφικά επίπεδα από τις πόλεις έως την παγκόσμια κλίμακα, ενώ η κοινωνία αναφέρεται σε μια ομάδα ατόμων που βρίσκονται σε συνεχή κοινωνική αλληλεπίδραση εντός κοινής επικράτειας, συχνά με τα ίδια πολιτικά και πολιτιστικά πρότυπα"@el;
        dct:creator      "Publications Office of the European Union";
        euvoc:xlNote     "θέμα συνόλου δεδομένων το οποίο καλύπτει τους τομείς του πληθυσμού και της κοινωνίας, όπου ο πληθυσμός αναφέρεται στον συνολικό αριθμό ατόμων που διαμένουν σε διάφορα γεωγραφικά επίπεδα από τις πόλεις έως την παγκόσμια κλίμακα, ενώ η κοινωνία αναφέρεται σε μια ομάδα ατόμων που βρίσκονται σε συνεχή κοινωνική αλληλεπίδραση εντός κοινής επικράτειας, συχνά με τα ίδια πολιτικά και πολιτιστικά πρότυπα"@el .

<data-theme/6fa869959eb90730449eafb7696e5e62>
        rdf:type         euvoc:XlNote;
        rdf:type         euvoc:XlNote;
        euvoc:startDate  "2015-10-01"^^<http://www.w3.org/2001/XMLSchema#date>;
        dct:created      "2024-05-22"^^<http://www.w3.org/2001/XMLSchema#date>;
        rdf:value        "tietojoukkoryhmä, joka kattaa väestön ja yhteiskunnan alat: väestöllä tarkoitetaan eri maantieteellisillä tasoilla kaupungeista maailmanlaajuiselle tasolle asuvien ihmisten kokonaismäärää ja yhteiskunta viittaa jatkuvaan sosiaaliseen kanssakäymiseen yhteisellä alueella, usein samojen poliittisen ja kulttuuristen normien puitteissa osallistuvaan henkilöryhmään"@fi;
        dct:creator      "Publications Office of the European Union";
        euvoc:xlNote     "tietojoukkoryhmä, joka kattaa väestön ja yhteiskunnan alat: väestöllä tarkoitetaan eri maantieteellisillä tasoilla kaupungeista maailmanlaajuiselle tasolle asuvien ihmisten kokonaismäärää ja yhteiskunta viittaa jatkuvaan sosiaaliseen kanssakäymiseen yhteisellä alueella, usein samojen poliittisen ja kulttuuristen normien puitteissa osallistuvaan henkilöryhmään"@fi .

<data-theme/1f605bfeae98579cae92ac5a7d3aeaba>
        rdf:type         euvoc:XlNote;
        rdf:type         euvoc:XlNote;
        euvoc:startDate  "2015-10-01"^^<http://www.w3.org/2001/XMLSchema#date>;
        dct:created      "2024-05-22"^^<http://www.w3.org/2001/XMLSchema#date>;
        rdf:value        "tema setului de date care vizează domeniile populației și societății, în care populația se referă la numărul total de persoane care locuiesc în diferite niveluri geografice, de la orașe la scară mondială, iar societatea desemnează un colectiv de persoane implicate într-o interacțiune socială continuă în cadrul unui teritoriu comun, adesea în temeiul acelorași norme politice și culturale"@ro;
        dct:creator      "Publications Office of the European Union";
        euvoc:xlNote     "tema setului de date care vizează domeniile populației și societății, în care populația se referă la numărul total de persoane care locuiesc în diferite niveluri geografice, de la orașe la scară mondială, iar societatea desemnează un colectiv de persoane implicate într-o interacțiune socială continuă în cadrul unui teritoriu comun, adesea în temeiul acelorași norme politice și culturale"@ro .

<data-theme/1f94926d374da68afa2808809a89fd6b>
        rdf:type         euvoc:XlNote;
        rdf:type         euvoc:XlNote;
        euvoc:startDate  "2015-10-01"^^<http://www.w3.org/2001/XMLSchema#date>;
        dct:created      "2024-05-22"^^<http://www.w3.org/2001/XMLSchema#date>;
        rdf:value        "duomenų rinkinio tema, apimanti gyventojų ir visuomenės sritis, kur gyventojai reiškia bendrą žmonių, gyvenančių įvairiais geografiniais lygmenimis – nuo miestų iki pasaulinio masto – skaičių, o visuomenė – asmenų, nuolat sąveikaujančių bendroje teritorijoje, dažnai pagal tas pačias politines ir kultūrines normas, grupė"@lt;
        dct:creator      "Publications Office of the European Union";
        euvoc:xlNote     "duomenų rinkinio tema, apimanti gyventojų ir visuomenės sritis, kur gyventojai reiškia bendrą žmonių, gyvenančių įvairiais geografiniais lygmenimis – nuo miestų iki pasaulinio masto – skaičių, o visuomenė – asmenų, nuolat sąveikaujančių bendroje teritorijoje, dažnai pagal tas pačias politines ir kultūrines normas, grupė"@lt .

<data-theme/dda6be98ddb9b2ac3304d35383ce0560>
        rdf:type         euvoc:XlNote;
        rdf:type         euvoc:XlNote;
        euvoc:startDate  "2015-10-01"^^<http://www.w3.org/2001/XMLSchema#date>;
        dct:created      "2024-05-22"^^<http://www.w3.org/2001/XMLSchema#date>;
        rdf:value        "andmestike teema, mis hõlmab selliseid valdkondi nagu elanikkond ja ühiskond, kui rahvastik tähendab selliste inimeste koguarvu, kes elavad eri geograafilistel tasanditel (linnadest üleilmse tasandini); ja mõiste „ühiskond“ tähistab üksikisikute kooslust, mille liikmed suhtlevad üksteisega pidevalt ühise territooriumi piires ning sageli samade poliitiliste ja kultuuriliste reeglite kohaselt"@et;
        dct:creator      "Publications Office of the European Union";
        euvoc:xlNote     "andmestike teema, mis hõlmab selliseid valdkondi nagu elanikkond ja ühiskond, kui rahvastik tähendab selliste inimeste koguarvu, kes elavad eri geograafilistel tasanditel (linnadest üleilmse tasandini); ja mõiste „ühiskond“ tähistab üksikisikute kooslust, mille liikmed suhtlevad üksteisega pidevalt ühise territooriumi piires ning sageli samade poliitiliste ja kultuuriliste reeglite kohaselt"@et .

<data-theme/0d5eb95cb50382cee4f4389effe163be>
        rdf:type         euvoc:XlNote;
        rdf:type         euvoc:XlNote;
        euvoc:startDate  "2015-10-01"^^<http://www.w3.org/2001/XMLSchema#date>;
        dct:created      "2024-05-22"^^<http://www.w3.org/2001/XMLSchema#date>;
        rdf:value        "tema podatkovnog skupa koja obuhvaća domenu stanovništva i društva, u kojoj se pojam stanovništva odnosi na ukupni broj stanovnika koji žive unutar različitih razina geografskih područja, od razine gradova do svjetske razine, a pojam društva na skup pojedinaca uključenih u stalno društveno međudjelovanje na zajedničkom teritoriju, često u okviru istih političkih i kulturoloških normi"@hr;
        dct:creator      "Publications Office of the European Union";
        euvoc:xlNote     "tema podatkovnog skupa koja obuhvaća domenu stanovništva i društva, u kojoj se pojam stanovništva odnosi na ukupni broj stanovnika koji žive unutar različitih razina geografskih područja, od razine gradova do svjetske razine, a pojam društva na skup pojedinaca uključenih u stalno društveno međudjelovanje na zajedničkom teritoriju, često u okviru istih političkih i kulturoloških normi"@hr .

<data-theme/37a0160f20595d91c211e52bd11be823>
        rdf:type         euvoc:XlNote;
        rdf:type         euvoc:XlNote;
        euvoc:startDate  "2015-10-01"^^<http://www.w3.org/2001/XMLSchema#date>;
        dct:created      "2024-05-22"^^<http://www.w3.org/2001/XMLSchema#date>;
        rdf:value        "тема на множество от данни, обхващаща областите на населението и обществото; население е съвкупността (общият брой) на хората, които живеят на различни географски равнища – от градско до световно равнище; обществото е колектив от физически лица, осъществяващи постоянно обществено взаимодействие, с обща територия, често при едни и същи политически и културни норми"@bg;
        dct:creator      "Publications Office of the European Union";
        euvoc:xlNote     "тема на множество от данни, обхващаща областите на населението и обществото; население е съвкупността (общият брой) на хората, които живеят на различни географски равнища – от градско до световно равнище; обществото е колектив от физически лица, осъществяващи постоянно обществено взаимодействие, с обща територия, често при едни и същи политически и културни норми"@bg .

<data-theme/b2acaa4e0c134bfd134b4884051ef182>
        rdf:type         euvoc:XlNote;
        rdf:type         euvoc:XlNote;
        euvoc:startDate  "2015-10-01"^^<http://www.w3.org/2001/XMLSchema#date>;
        dct:created      "2024-05-22"^^<http://www.w3.org/2001/XMLSchema#date>;
        rdf:value        "A népesség és a társadalom területeit lefedő adatkészlet-téma, ahol a népesség a városoktól a globális szintig terjedő különböző földrajzi egységekben élő személyek teljes számát jelenti, a társadalom pedig a közös területen élő, gyakorta ugyanazon politikai és kulturális normákkal rendelkező és folyamatos társadalmi kapcsolatokban részt vevő személyek összességét jelöli."@hu;
        dct:creator      "Publications Office of the European Union";
        euvoc:xlNote     "A népesség és a társadalom területeit lefedő adatkészlet-téma, ahol a népesség a városoktól a globális szintig terjedő különböző földrajzi egységekben élő személyek teljes számát jelenti, a társadalom pedig a közös területen élő, gyakorta ugyanazon politikai és kulturális normákkal rendelkező és folyamatos társadalmi kapcsolatokban részt vevő személyek összességét jelöli."@hu .

<data-theme/cd7bd63a7c2b29e0fe5032bbbc508fd3>
        rdf:type         euvoc:XlNote;
        rdf:type         euvoc:XlNote;
        euvoc:startDate  "2015-10-01"^^<http://www.w3.org/2001/XMLSchema#date>;
        dct:created      "2024-05-22"^^<http://www.w3.org/2001/XMLSchema#date>;
        rdf:value        "thème d’un ensemble de données couvrant les domaines de la population et de la société, la population faisant référence au nombre total de personnes résidant à différents niveaux géographiques, allant des villes jusqu’à l’échelle mondiale, et la société désignant un collectif de personnes engagées dans une interaction sociale continue au sein d’un territoire commun, souvent dans le cadre des mêmes normes politiques et culturelles"@fr;
        dct:creator      "Publications Office of the European Union";
        euvoc:xlNote     "thème d’un ensemble de données couvrant les domaines de la population et de la société, la population faisant référence au nombre total de personnes résidant à différents niveaux géographiques, allant des villes jusqu’à l’échelle mondiale, et la société désignant un collectif de personnes engagées dans une interaction sociale continue au sein d’un territoire commun, souvent dans le cadre des mêmes normes politiques et culturelles"@fr .

<data-theme/afb3e37c48025d9cfb4706b436104333>
        rdf:type         euvoc:XlNote;
        rdf:type         euvoc:XlNote;
        euvoc:startDate  "2015-10-01"^^<http://www.w3.org/2001/XMLSchema#date>;
        dct:created      "2024-05-22"^^<http://www.w3.org/2001/XMLSchema#date>;
        rdf:value        "tema de un conjunto de datos que abarca los ámbitos de la población, que se refiere al número total de personas que residen en los distintos niveles geográficos —desde las ciudades hasta la escala mundial—, y la sociedad, que denota un colectivo de personas que participan en una interacción social continua dentro de un territorio común, a menudo con arreglo a las mismas normas políticas y culturales"@es;
        dct:creator      "Publications Office of the European Union";
        euvoc:xlNote     "tema de un conjunto de datos que abarca los ámbitos de la población, que se refiere al número total de personas que residen en los distintos niveles geográficos —desde las ciudades hasta la escala mundial—, y la sociedad, que denota un colectivo de personas que participan en una interacción social continua dentro de un territorio común, a menudo con arreglo a las mismas normas políticas y culturales"@es .

<data-theme/aa1d90c773a418d93b769b48a54e8d33>
        rdf:type         euvoc:XlNote;
        rdf:type         euvoc:XlNote;
        euvoc:startDate  "2015-10-01"^^<http://www.w3.org/2001/XMLSchema#date>;
        dct:created      "2024-05-22"^^<http://www.w3.org/2001/XMLSchema#date>;
        rdf:value        "téma datového souboru týkající se oblastí obyvatelstva a společnosti, kde obyvatelstvo znamená celkový počet osob usídlených na různých geografických úrovních, od měst až po celosvětovou úroveň, a společnost označuje seskupení jednotlivců zapojených do nepřetržité sociální interakce na společném území, často na základě stejných politických a kulturních norem"@cs;
        dct:creator      "Publications Office of the European Union";
        euvoc:xlNote     "téma datového souboru týkající se oblastí obyvatelstva a společnosti, kde obyvatelstvo znamená celkový počet osob usídlených na různých geografických úrovních, od měst až po celosvětovou úroveň, a společnost označuje seskupení jednotlivců zapojených do nepřetržité sociální interakce na společném území, často na základě stejných politických a kulturních norem"@cs .

<data-theme/0e95f9a8c7e57132025ac56a71f8005d>
        rdf:type         euvoc:XlNote;
        rdf:type         euvoc:XlNote;
        euvoc:startDate  "2015-10-01"^^<http://www.w3.org/2001/XMLSchema#date>;
        dct:created      "2024-05-22"^^<http://www.w3.org/2001/XMLSchema#date>;
        rdf:value        "Datensatzthema für die Bereiche Bevölkerung und Gesellschaft, wobei „Bevölkerung“ sich auf die Gesamtzahl der Menschen bezieht, die in geografischen Einheiten – von der Städte- bis zur globalen Ebene – ansässig sind, während „Gesellschaft“ eine Gemeinschaft von Individuen bezeichnet, die sich innerhalb eines gemeinsamen Gebiets in ständiger sozialer Interaktion befinden und oft denselben politischen und kulturellen Normen unterliegen"@de;
        dct:creator      "Publications Office of the European Union";
        euvoc:xlNote     "Datensatzthema für die Bereiche Bevölkerung und Gesellschaft, wobei „Bevölkerung“ sich auf die Gesamtzahl der Menschen bezieht, die in geografischen Einheiten – von der Städte- bis zur globalen Ebene – ansässig sind, während „Gesellschaft“ eine Gemeinschaft von Individuen bezeichnet, die sich innerhalb eines gemeinsamen Gebiets in ständiger sozialer Interaktion befinden und oft denselben politischen und kulturellen Normen unterliegen"@de .

<data-theme/004081774e5b56b2eb278a3ccf23babc>
        rdf:type         euvoc:XlNote;
        rdf:type         euvoc:XlNote;
        euvoc:startDate  "2015-10-01"^^<http://www.w3.org/2001/XMLSchema#date>;
        dct:created      "2024-05-22"^^<http://www.w3.org/2001/XMLSchema#date>;
        rdf:value        "téama tacair sonraí lena gcumhdaítear réimse an daonra agus réimse na sochaí, de réir an tsainithe gurb é is daonra ann an líon iomlán daoine atá ina gcónaí laistigh de limistéir gheografacha éagsúla, bídís sin ar leibhéal na gcathracha, ar an leibhéal domhanda nó eile, agus gurb é rud a chiallaíonn an tsochaí ná comharghrúpa daoine aonair atá i mbun idirghníomhaíocht shóisialta leanúnach laistigh de chríoch choiteann, agus an idirghníomhaíocht sin faoi réir noirm choiteanna pholaitiúla agus chultúrtha i roinnt mhaith cásanna"@ga;
        dct:creator      "Publications Office of the European Union";
        euvoc:xlNote     "téama tacair sonraí lena gcumhdaítear réimse an daonra agus réimse na sochaí, de réir an tsainithe gurb é is daonra ann an líon iomlán daoine atá ina gcónaí laistigh de limistéir gheografacha éagsúla, bídís sin ar leibhéal na gcathracha, ar an leibhéal domhanda nó eile, agus gurb é rud a chiallaíonn an tsochaí ná comharghrúpa daoine aonair atá i mbun idirghníomhaíocht shóisialta leanúnach laistigh de chríoch choiteann, agus an idirghníomhaíocht sin faoi réir noirm choiteanna pholaitiúla agus chultúrtha i roinnt mhaith cásanna"@ga .

<data-theme/e737207c938ce2e67f3e861f86044aef>
        rdf:type         euvoc:XlNote;
        rdf:type         euvoc:XlNote;
        euvoc:startDate  "2015-10-01"^^<http://www.w3.org/2001/XMLSchema#date>;
        dct:created      "2024-05-22"^^<http://www.w3.org/2001/XMLSchema#date>;
        rdf:value        "datasetthema dat betrekking heeft op de domeinen bevolking en samenleving, waarbij bevolking verwijst naar het totale aantal mensen dat verblijft op verschillende geografische niveaus van stad tot wereldschaal, en samenleving verwijst naar een collectief van personen die betrokken zijn bij duurzame sociale interactie binnen een gemeenschappelijk gebied, vaak met dezelfde politieke en culturele normen"@nl;
        dct:creator      "Publications Office of the European Union";
        euvoc:xlNote     "datasetthema dat betrekking heeft op de domeinen bevolking en samenleving, waarbij bevolking verwijst naar het totale aantal mensen dat verblijft op verschillende geografische niveaus van stad tot wereldschaal, en samenleving verwijst naar een collectief van personen die betrokken zijn bij duurzame sociale interactie binnen een gemeenschappelijk gebied, vaak met dezelfde politieke en culturele normen"@nl .

<data-theme/2ee00c1d4ba3155f8e606453d27cf7d3>
        rdf:type         euvoc:XlNote;
        rdf:type         euvoc:XlNote;
        euvoc:startDate  "2015-10-01"^^<http://www.w3.org/2001/XMLSchema#date>;
        dct:created      "2024-05-22"^^<http://www.w3.org/2001/XMLSchema#date>;
        rdf:value        "dataset för områdena befolkning och samhälle, där befolkning avser det totala antalet personer som bor på olika geografiska nivåer, från städer till global nivå, medan samhälle avser en grupp individer som deltar i kontinuerlig social interaktion inom ett gemensamt territorium, ofta enligt samma politiska och kulturella normer."@sv;
        dct:creator      "Publications Office of the European Union";
        euvoc:xlNote     "dataset för områdena befolkning och samhälle, där befolkning avser det totala antalet personer som bor på olika geografiska nivåer, från städer till global nivå, medan samhälle avser en grupp individer som deltar i kontinuerlig social interaktion inom ett gemensamt territorium, ofta enligt samma politiska och kulturella normer."@sv .

<data-theme/87dc04f37b2f999eac632fb138c78abe>
        rdf:type         euvoc:XlNote;
        rdf:type         euvoc:XlNote;
        euvoc:startDate  "2015-10-01"^^<http://www.w3.org/2001/XMLSchema#date>;
        dct:created      "2024-05-22"^^<http://www.w3.org/2001/XMLSchema#date>;
        rdf:value        "podatkovni nabor, ki pokriva področji prebivalstva in družbe, pri čemer se populacija nanaša na skupno število oseb, ki prebivajo v različnih geografskih enotah (od mest do globalne ravni), medtem ko družba označuje skupnost posameznikov, ki so na določenem območju v neprekinjeni družbeni interakciji, navadno z enakimi političnimi in kulturnimi merili"@sl;
        dct:creator      "Publications Office of the European Union";
        euvoc:xlNote     "podatkovni nabor, ki pokriva področji prebivalstva in družbe, pri čemer se populacija nanaša na skupno število oseb, ki prebivajo v različnih geografskih enotah (od mest do globalne ravni), medtem ko družba označuje skupnost posameznikov, ki so na določenem območju v neprekinjeni družbeni interakciji, navadno z enakimi političnimi in kulturnimi merili"@sl .

<data-theme/5fb4cb573c20b1279425003616be5dc8>
        rdf:type         euvoc:XlNote;
        rdf:type         euvoc:XlNote;
        euvoc:startDate  "2015-10-01"^^<http://www.w3.org/2001/XMLSchema#date>;
        dct:created      "2024-05-22"^^<http://www.w3.org/2001/XMLSchema#date>;
        rdf:value        "tema ta’ sett tad-data li tkopri l-oqsma tal-popolazzjoni u tas-soċjetà, fejn il-popolazzjoni tirreferi għall-għadd totali ta’ persuni li jgħixu f’diversi livelli ġeografiċi mill-bliet sal-iskala dinjija, u fejn is-soċjetà tirrappreżenta grupp ta’ individwi involuti f’interazzjoni soċjali kontinwa f’territorju komuni, spiss taħt l-istess normi politiċi u kulturali"@mt;
        dct:creator      "Publications Office of the European Union";
        euvoc:xlNote     "tema ta’ sett tad-data li tkopri l-oqsma tal-popolazzjoni u tas-soċjetà, fejn il-popolazzjoni tirreferi għall-għadd totali ta’ persuni li jgħixu f’diversi livelli ġeografiċi mill-bliet sal-iskala dinjija, u fejn is-soċjetà tirrappreżenta grupp ta’ individwi involuti f’interazzjoni soċjali kontinwa f’territorju komuni, spiss taħt l-istess normi politiċi u kulturali"@mt .

<data-theme/6f416fd49f9e07b71556b330d6e4256a>
        rdf:type         euvoc:XlNote;
        rdf:type         euvoc:XlNote;
        euvoc:startDate  "2015-10-01"^^<http://www.w3.org/2001/XMLSchema#date>;
        dct:created      "2024-05-22"^^<http://www.w3.org/2001/XMLSchema#date>;
        rdf:value        "conjunto de dados cujo tema abrange os domínios da população e da sociedade, em que a população se refere ao número total de pessoas que residem em vários níveis geográficos, desde os municípios até à escala mundial, e a sociedade designa um coletivo de indivíduos envolvidos numa interação social contínua num território comum, frequentemente segundo as mesmas normas políticas e culturais"@pt;
        dct:creator      "Publications Office of the European Union";
        euvoc:xlNote     "conjunto de dados cujo tema abrange os domínios da população e da sociedade, em que a população se refere ao número total de pessoas que residem em vários níveis geográficos, desde os municípios até à escala mundial, e a sociedade designa um coletivo de indivíduos envolvidos numa interação social contínua num território comum, frequentemente segundo as mesmas normas políticas e culturais"@pt .

<data-theme/f7aa0ca2af07de501b12c7a185633f85>
        rdf:type         euvoc:XlNote;
        rdf:type         euvoc:XlNote;
        euvoc:startDate  "2015-10-01"^^<http://www.w3.org/2001/XMLSchema#date>;
        dct:created      "2024-05-22"^^<http://www.w3.org/2001/XMLSchema#date>;
        rdf:value        "tema di serie di dati relativo ai settori della popolazione e della società, ove la popolazione riguarda il numero totale di persone che risiedono in vari livelli geografici, dalle città alla scala mondiale, mentre la società indica un insieme di individui impegnati in un'interazione sociale regolare nell'ambito di un territorio comune, spesso con le stesse norme politiche e culturali"@it;
        dct:creator      "Publications Office of the European Union";
        euvoc:xlNote     "tema di serie di dati relativo ai settori della popolazione e della società, ove la popolazione riguarda il numero totale di persone che risiedono in vari livelli geografici, dalle città alla scala mondiale, mentre la società indica un insieme di individui impegnati in un'interazione sociale regolare nell'ambito di un territorio comune, spesso con le stesse norme politiche e culturali"@it .

<data-theme/d5a2ca5e8f9df89167618ea716822189>
        rdf:type         euvoc:XlNote;
        rdf:type         euvoc:XlNote;
        euvoc:startDate  "2015-10-01"^^<http://www.w3.org/2001/XMLSchema#date>;
        dct:created      "2024-05-22"^^<http://www.w3.org/2001/XMLSchema#date>;
        rdf:value        "tema for datasæt, som vedrører områderne befolkning og samfund, hvor befolkning henviser til det samlede antal mennesker, der bor på forskellige geografiske niveauer, fra byer til globalt plan, mens samfund betegner en gruppe af personer, der løbende interagerer socialt inden for et fælles territorium og ofte efter de samme politiske og kulturelle normer"@da;
        dct:creator      "Publications Office of the European Union";
        euvoc:xlNote     "tema for datasæt, som vedrører områderne befolkning og samfund, hvor befolkning henviser til det samlede antal mennesker, der bor på forskellige geografiske niveauer, fra byer til globalt plan, mens samfund betegner en gruppe af personer, der løbende interagerer socialt inden for et fælles territorium og ofte efter de samme politiske og kulturelle normer"@da .

<data-theme/14253c1b91fe242d8602efd1e33e33bf>
        rdf:type         euvoc:XlNote;
        rdf:type         euvoc:XlNote;
        euvoc:startDate  "2015-10-01"^^<http://www.w3.org/2001/XMLSchema#date>;
        dct:created      "2024-05-22"^^<http://www.w3.org/2001/XMLSchema#date>;
