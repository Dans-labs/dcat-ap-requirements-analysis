<data-theme/12f7771b52b45c83507d5770e052a9bb>
        rdf:type         euvoc:XlNote;
        rdf:type         euvoc:XlNote;
        euvoc:startDate  "2015-10-01"^^<http://www.w3.org/2001/XMLSchema#date>;
        dct:created      "2024-05-22"^^<http://www.w3.org/2001/XMLSchema#date>;
        rdf:value        "θέμα συνόλου δεδομένων το οποίο καλύπτει τους τομείς της δημόσιας διοίκησης και του δημόσιου τομέα, όπου η δημόσια διοίκηση αποτελεί το σύστημα ή την ομάδα ατόμων που διοικεί μια οργανωμένη κοινότητα, συνήθως ένα κράτος, και ο δημόσιος τομέας περιλαμβάνει το τμήμα της οικονομίας που αφορά δημόσιες υπηρεσίες και επιχειρήσεις, οι οποίες μπορεί να τελούν υπό τη διαχείριση κεντρικών, περιφερειακών ή τοπικών αρχών"@el;
        dct:creator      "Publications Office of the European Union";
        euvoc:xlNote     "θέμα συνόλου δεδομένων το οποίο καλύπτει τους τομείς της δημόσιας διοίκησης και του δημόσιου τομέα, όπου η δημόσια διοίκηση αποτελεί το σύστημα ή την ομάδα ατόμων που διοικεί μια οργανωμένη κοινότητα, συνήθως ένα κράτος, και ο δημόσιος τομέας περιλαμβάνει το τμήμα της οικονομίας που αφορά δημόσιες υπηρεσίες και επιχειρήσεις, οι οποίες μπορεί να τελούν υπό τη διαχείριση κεντρικών, περιφερειακών ή τοπικών αρχών"@el .

