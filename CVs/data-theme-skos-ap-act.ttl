<data-theme/fabb2e749343986fc6609148571e6b17>
        rdf:type         euvoc:XlNote;
        rdf:type         euvoc:XlNote;
        euvoc:startDate  "2015-10-01"^^<http://www.w3.org/2001/XMLSchema#date>;
        dct:created      "2024-05-22"^^<http://www.w3.org/2001/XMLSchema#date>;
        rdf:value        "thème d’un ensemble de données couvrant les domaines de l’activité économique au nombre desquels la production, la distribution, les échanges et la consommation de biens et de services, et l’activité financière axée sur la gestion de l’argent au niveau des individus, des entreprises ou des administrations publiques"@fr;
        dct:creator      "Publications Office of the European Union";
        euvoc:xlNote     "thème d’un ensemble de données couvrant les domaines de l’activité économique au nombre desquels la production, la distribution, les échanges et la consommation de biens et de services, et l’activité financière axée sur la gestion de l’argent au niveau des individus, des entreprises ou des administrations publiques"@fr .

<data-theme/56a996dbfe5468481bb900b4b03aed0e>
        rdf:type         euvoc:XlNote;
        rdf:type         euvoc:XlNote;
        euvoc:startDate  "2015-10-01"^^<http://www.w3.org/2001/XMLSchema#date>;
        dct:created      "2024-05-22"^^<http://www.w3.org/2001/XMLSchema#date>;
        rdf:value        "datasetthema dat betrekking heeft op de domeinen economie, waarbij het gaat om de productie, distributie, handel en consumptie van goederen en diensten; en financiën, waarbij het gaat om activiteiten gericht op het beheer van geld op het niveau van personen, bedrijven of de overheid"@nl;
        dct:creator      "Publications Office of the European Union";
        euvoc:xlNote     "datasetthema dat betrekking heeft op de domeinen economie, waarbij het gaat om de productie, distributie, handel en consumptie van goederen en diensten; en financiën, waarbij het gaat om activiteiten gericht op het beheer van geld op het niveau van personen, bedrijven of de overheid"@nl .

<data-theme/76f4c794d174aae3b2774495e0277913>
        rdf:type         euvoc:XlNote;
        rdf:type         euvoc:XlNote;
        euvoc:startDate  "2015-10-01"^^<http://www.w3.org/2001/XMLSchema#date>;
        dct:created      "2024-05-22"^^<http://www.w3.org/2001/XMLSchema#date>;
        rdf:value        "temat zbioru danych obejmujący dziedziny działalności gospodarczej, takie jak: produkcja i dystrybucja towarów i usług, obrót nimi oraz korzystanie z nich, a także działalność finansowa koncentrująca się na zarządzaniu pieniędzmi na poziomie osoby fizycznej, przedsiębiorstwa lub na szczeblu rządowym"@pl;
        dct:creator      "Publications Office of the European Union";
        euvoc:xlNote     "temat zbioru danych obejmujący dziedziny działalności gospodarczej, takie jak: produkcja i dystrybucja towarów i usług, obrót nimi oraz korzystanie z nich, a także działalność finansowa koncentrująca się na zarządzaniu pieniędzmi na poziomie osoby fizycznej, przedsiębiorstwa lub na szczeblu rządowym"@pl .

<data-theme/3e5bd4e0ade73d1e513c11468562af84>
        rdf:type         euvoc:XlNote;
        rdf:type         euvoc:XlNote;
        euvoc:startDate  "2015-10-01"^^<http://www.w3.org/2001/XMLSchema#date>;
        dct:created      "2024-05-22"^^<http://www.w3.org/2001/XMLSchema#date>;
        rdf:value        "tema podatkovnog skupa koja obuhvaća domenu gospodarskih aktivnosti, što uključuje proizvodnju, distribuciju, trgovinu i potrošnju robe i usluga, te domenu financijskih aktivnosti usmjerenih na upravljanje novčanim sredstvima pojedinaca, poduzeća ili javnih sredstava"@hr;
        dct:creator      "Publications Office of the European Union";
        euvoc:xlNote     "tema podatkovnog skupa koja obuhvaća domenu gospodarskih aktivnosti, što uključuje proizvodnju, distribuciju, trgovinu i potrošnju robe i usluga, te domenu financijskih aktivnosti usmjerenih na upravljanje novčanim sredstvima pojedinaca, poduzeća ili javnih sredstava"@hr .

<data-theme/e3ee7b5cb2ce23fdabe587666999f6bc>
        rdf:type         euvoc:XlNote;
        rdf:type         euvoc:XlNote;
        euvoc:startDate  "2015-10-01"^^<http://www.w3.org/2001/XMLSchema#date>;
        dct:created      "2024-05-22"^^<http://www.w3.org/2001/XMLSchema#date>;
        rdf:value        "Datensatzthema für die Bereiche Wirtschaftstätigkeiten, worunter die Herstellung und Verteilung von Waren und Dienstleistungen sowie der Handel mit ihnen und ihr Verbrauch bzw. ihre Inanspruchnahme fallen, und finanzielle Tätigkeiten, die schwerpunktmäßig der Verwaltung von Geld auf individueller, betrieblicher oder staatlicher Ebene gelten"@de;
        dct:creator      "Publications Office of the European Union";
        euvoc:xlNote     "Datensatzthema für die Bereiche Wirtschaftstätigkeiten, worunter die Herstellung und Verteilung von Waren und Dienstleistungen sowie der Handel mit ihnen und ihr Verbrauch bzw. ihre Inanspruchnahme fallen, und finanzielle Tätigkeiten, die schwerpunktmäßig der Verwaltung von Geld auf individueller, betrieblicher oder staatlicher Ebene gelten"@de .

<data-theme/1260ffe4f9baacb743ffe8ac078084f4>
        rdf:type         euvoc:XlNote;
        rdf:type         euvoc:XlNote;
        euvoc:startDate  "2015-10-01"^^<http://www.w3.org/2001/XMLSchema#date>;
        dct:created      "2024-05-22"^^<http://www.w3.org/2001/XMLSchema#date>;
        rdf:value        "dataset för områdena ekonomisk verksamhet, med produktion, distribution, handel och konsumtion av varor och tjänster, samt finansiell verksamhet med inriktning på förvaltning av pengar på individuell nivå, företagsnivå eller myndighetsnivå."@sv;
        dct:creator      "Publications Office of the European Union";
        euvoc:xlNote     "dataset för områdena ekonomisk verksamhet, med produktion, distribution, handel och konsumtion av varor och tjänster, samt finansiell verksamhet med inriktning på förvaltning av pengar på individuell nivå, företagsnivå eller myndighetsnivå."@sv .

<data-theme/8b43911df000a8db37bd5aa4c389c784>
        rdf:type         euvoc:XlNote;
        rdf:type         euvoc:XlNote;
        euvoc:startDate  "2015-10-01"^^<http://www.w3.org/2001/XMLSchema#date>;
        dct:created      "2024-05-22"^^<http://www.w3.org/2001/XMLSchema#date>;
        rdf:value        "conjunto de dados cujo tema abrange os domínios da atividade económica que envolvem a produção, a distribuição, o comércio e o consumo de bens e serviços, e a atividade financeira centrada na gestão financeira a nível individual, empresarial ou governamental"@pt;
        dct:creator      "Publications Office of the European Union";
