<data-theme/d46e778aa48c0eb2020b42dbb90ab1da>
        rdf:type         euvoc:XlNote;
        rdf:type         euvoc:XlNote;
        euvoc:startDate  "2015-10-01"^^<http://www.w3.org/2001/XMLSchema#date>;
        dct:created      "2024-05-22"^^<http://www.w3.org/2001/XMLSchema#date>;
        rdf:value        "datu kopa, kas aptver tādas jomas kā iedzīvotāji un sabiedrība, kur ar iedzīvotājiem saprot to cilvēku kopskaitu, kuri dzīvo dažādos ģeogrāfiskajos līmeņos, sākot no pilsētām līdz pasaules mērogam, bet ar sabiedrību –– to personu grupu, kura iesaistīta nepārtrauktā sociālā mijiedarbībā kādā kopējā teritorijā un kura bieži vien ir pieņēmusi un ievēro vienas un tās pašas politiskās un kultūras normas"@lv;
        dct:creator      "Publications Office of the European Union";
        euvoc:xlNote     "datu kopa, kas aptver tādas jomas kā iedzīvotāji un sabiedrība, kur ar iedzīvotājiem saprot to cilvēku kopskaitu, kuri dzīvo dažādos ģeogrāfiskajos līmeņos, sākot no pilsētām līdz pasaules mērogam, bet ar sabiedrību –– to personu grupu, kura iesaistīta nepārtrauktā sociālā mijiedarbībā kādā kopējā teritorijā un kura bieži vien ir pieņēmusi un ievēro vienas un tās pašas politiskās un kultūras normas"@lv .

