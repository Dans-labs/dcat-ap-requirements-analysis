        dct:created      "2024-05-22"^^<http://www.w3.org/2001/XMLSchema#date>;
        rdf:value        "andmestike teema, mis hõlmab selliseid valdkondi nagu õigusemõistmine, õigussüsteem ja avalik julgeolek, kusjuures õigusemõistmine tähendab õiglast menetlust õigusaktide kohaldamisel, õigussüsteemi kuuluvad mitmesugused raamistikud, nagu tsiviilõigus, üldine õigus, õigusaktid ja religioossed normid, avalik julgeolek aga tähendab valitsuse kohustust kaitsta üksikisikuid, organisatsioone ja institutsioone nende ja kogukonna heaolu ähvardavate ohtude eest"@et;
        dct:creator      "Publications Office of the European Union";
        euvoc:xlNote     "andmestike teema, mis hõlmab selliseid valdkondi nagu õigusemõistmine, õigussüsteem ja avalik julgeolek, kusjuures õigusemõistmine tähendab õiglast menetlust õigusaktide kohaldamisel, õigussüsteemi kuuluvad mitmesugused raamistikud, nagu tsiviilõigus, üldine õigus, õigusaktid ja religioossed normid, avalik julgeolek aga tähendab valitsuse kohustust kaitsta üksikisikuid, organisatsioone ja institutsioone nende ja kogukonna heaolu ähvardavate ohtude eest"@et .

<data-theme/dbf2bd4cb19c0f35528428e0dedc7c16>
        rdf:type         euvoc:XlNote;
        rdf:type         euvoc:XlNote;
        euvoc:startDate  "2015-10-01"^^<http://www.w3.org/2001/XMLSchema#date>;
        dct:created      "2024-05-22"^^<http://www.w3.org/2001/XMLSchema#date>;
        rdf:value        "dataset theme covering the domains of justice, legal system and public safety, where justice refers to the procedural fairness in the application of law; legal system comprises various frameworks including civil, common, statutory, and religious law; and public safety denotes the governmental responsibility to protect individuals, organisations, and institutions from threats to their well-being and community prosperity"@en;
        dct:creator      "Publications Office of the European Union";
        euvoc:xlNote     "dataset theme covering the domains of justice, legal system and public safety, where justice refers to the procedural fairness in the application of law; legal system comprises various frameworks including civil, common, statutory, and religious law; and public safety denotes the governmental responsibility to protect individuals, organisations, and institutions from threats to their well-being and community prosperity"@en .

<data-theme/969f77c6219362b6a083a4fe95a69396>
        rdf:type         euvoc:XlNote;
        rdf:type         euvoc:XlNote;
