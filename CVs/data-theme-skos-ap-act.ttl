        euvoc:xlDefinition  <data-theme/f9a8fa52395e37884759295b4b2dbeb5>;
        euvoc:xlDefinition  <data-theme/a5707f4af1b61ea58deb0dfa7bc8b925>;
        euvoc:xlDefinition  <data-theme/3918b2f469980e799a69b8c4de5a4251>;
        euvoc:xlDefinition  <data-theme/abc9629a2ea56437edf9c9521151750b>;
        euvoc:xlDefinition  <data-theme/2fa9b337bd75df39c8af3e4be6f4e128>;
        euvoc:xlDefinition  <data-theme/bd5f27abad4527a5cc70369c628fbef7>;
        euvoc:xlDefinition  <data-theme/3532e603bf0f9f7cdbd7d83960919806>;
        euvoc:xlDefinition  <data-theme/5b6ad8bb61fb0031e856a82d37de03fb>;
        euvoc:xlDefinition  <data-theme/e7d52f6a9fabfeac2ad6721a957781e8>;
        euvoc:xlDefinition  <data-theme/599a657042591e30bdf02aa49fd098ee>;
        euvoc:xlDefinition  <data-theme/082ebe3d845516d0f5f559c1c460c7f5>;
        euvoc:xlDefinition  <data-theme/87c1d6a46df81a87be345a4fd3609127>;
        euvoc:xlDefinition  <data-theme/af34e739e8f1d1e985dde6b5ed47cfde>;
        euvoc:xlDefinition  <data-theme/bd3652d4708e725b913781b579022379>;
        euvoc:xlDefinition  <data-theme/71f5b1c0eccf3e51df4fb47f01a789a7>;
        euvoc:xlDefinition  <data-theme/90507ce694f88cf92b2fb3a96b2fc11d>;
        dct:dateAccepted    "2015-10-09"^^<http://www.w3.org/2001/XMLSchema#date>;
        dct:dateSubmitted   "2015-10-09"^^<http://www.w3.org/2001/XMLSchema#date>;
        owl:versionInfo     "20241211-0";
        skos:definition     "тема на множество от данни, обхващаща областите на регионите и градовете; регионите са определени от политическата география единици, включващи суверенните държави, поднационалните административни подразделения и многонационалните обединения; градовете се определят като големи човешки поселища"@bg;
        skos:definition     "tietojoukkoryhmä, joka kattaa alueiden ja kaupunkien alat: alueet määritellään poliittisiksi maantieteellisiksi yksiköksi, joihin kuuluu suvereeneja valtioita, valtiotasoa alempia hallintoalueita ja monikansallisia ryhmittymiä, ja kaupunkeja voidaan pitää suurina asuinyhdyskuntina"@fi;
        skos:definition     "dataset theme covering the domains of regions and cities, where regions is defined by political geography units including sovereign states, subnational administrative areas, and multinational groupings, and cities are characterised as large human settlements"@en;
        skos:definition     "tema di serie di dati relativo ai settori delle regioni e delle città, ove per regioni si intendono unità geografiche e politiche tra cui rientrano gli stati sovrani, le unità amministrative subnazionali e i raggruppamenti multinazionali, mentre le città sono definite come ampi insediamenti umani"@it;
        skos:definition     "téma dátového súboru pokrývajúca oblasti regiónov a miest, pričom regióny sú vymedzené politickými geografickými jednotkami, a to vrátane zvrchovaných štátov, správnych oblastí na nižšej ako celoštátnej úrovni a nadnárodných zoskupení, a mestá sú charakterizované ako veľké ľudské sídla"@sk;
        skos:definition     "conjunto de dados cujo tema abrange os domínios das regiões e dos municípios, em que as regiões são definidas por unidades geográficas políticas, incluindo Estados soberanos, zonas administrativas infranacionais e agrupamentos multinacionais, e os municípios são caracterizados como grandes assentamentos humanos"@pt;
        skos:definition     "duomenų rinkinio tema, apimanti regionų ir miestų sritis, kur regionai apibrėžiami kaip politiniai geografiniai vienetai, tokie kaip suverenios valstybės, subnacionalinės administracinės teritorijos ir daugiašalės grupės, o miestai apibūdinami kaip didelės žmonių gyvenvietės"@lt;
        skos:definition     "tema de un conjunto de datos que abarca los ámbitos de las regiones, definidas como unidades geográficas políticas —por ejemplo, los Estados soberanos, las zonas administrativas subnacionales y las agrupaciones multinacionales—, y las ciudades, que se caracterizan como grandes asentamientos humanos"@es;
        skos:definition     "A régiók és városok ügyét lefedő adatkészlet-téma, ahol a régiók politikai földrajzi egységek, ideértve a szuverén államokat, a nemzeti szint alatti közigazgatási területeket és a multinacionális csoportosulásokat is, míg a városok nagy települések."@hu;
        skos:definition     "Datensatzthema für die Bereiche Regionen und Städte, wobei Regionen als politisch-geografische Einheiten, darunter souveräne Staaten, subnationale Verwaltungsgebiete und multinationale Gruppierungen, Städte dagegen als große menschliche Siedlungen definiert sind"@de;
        skos:definition     "tema podatkovnog skupa koja obuhvaća domenu regija i gradova, u kojoj su regije definirane kao političke geografske jedinice uključujući suverene države, podnacionalna administrativna područja i multinacionalne grupacije, a gradovi su velika ljudska naselja"@hr;
        skos:definition     "téma datového souboru týkající se oblastí regionů a měst, kde se pojmem regiony rozumí politicko-geografické jednotky, které zahrnují svrchované státy, správní oblasti na nižší než celostátní úrovni a mnohonárodní uskupení, a města jsou charakterizována jako velká lidská sídla"@cs;
        skos:definition     "datu kopa, kas aptver tādas jomas kā reģioni un pilsētas, kur reģionus definē pēc politiski ģeogrāfiskām vienībām, tostarp suverēnām valstīm, vietējām administratīvajām teritorijām un daudznacionāliem grupējumiem, bet pilsētas raksturojamas kā lielas apdzīvotas vietas"@lv;
        skos:definition     "tema for datasæt, som vedrører områderne regioner og byer, hvor regionerne er defineret af politisk-geografiske enheder, herunder suveræne stater, subnationale administrative områder og multinationale grupperinger, mens byer er karakteriseret som store menneskelige bosættelser"@da;
        skos:definition     "θέμα συνόλου δεδομένων το οποίο καλύπτει τους τομείς των περιφερειών και των πόλεων, όπου οι περιφέρειες αποτελούν πολιτικές γεωγραφικές ενότητες, συμπεριλαμβανομένων κυρίαρχων κρατών, υποεθνικών διοικητικών περιοχών και πολυεθνικών ομάδων, και οι πόλεις χαρακτηρίζονται ως μεγάλοι ανθρώπινοι οικισμοί"@el;
        skos:definition     "thème d’un ensemble de données couvrant les domaines des régions et des villes, les régions étant définies par des unités de géographie politique, dont les États souverains, les zones administratives infranationales et les groupements multinationaux, et les villes étant définies comme de grands établissements humains"@fr;
        skos:definition     "tema setului de date care vizează domeniile regiunilor și orașelor, în care regiunile sunt definite de unități geografice politice, inclusiv de state suverane, zone administrative subnaționale și grupări multinaționale, iar orașele sunt caracterizate ca așezări omenești mari"@ro;
        skos:definition     "datasetthema dat betrekking heeft op de domeinen regio’s en steden, waarbij regio’s het domein is van politieke geografische eenheden, waaronder soevereine staten, subnationale bestuurlijke gebieden en multinationale groeperingen, en het domein steden betrekking heeft op grote menselijke nederzettingen"@nl;
        skos:definition     "andmestike teema, mis hõlmab selliseid valdkondi nagu piirkonnad ja linnad, kui piirkond on määratletud kui poliitgeograafia üksus ja hõlmab suveräänseid riike, riigi tasandist madalamale tasandil olevaid halduspiirkondi ja rahvusvahelisi rühmi, ning linnade puhul on tegu suurte asulatega"@et;
        skos:definition     "podatkovni nabor, ki pokriva področji regij in mest, pri čemer so regije opredeljene kot politične geografske enote, vključno s suverenimi državami, podnacionalnimi upravnimi enotami in večnacionalnimi združbami, medtem ko so za mesta značilna velike človeške naselbine"@sl;
        skos:definition     "dataset för områdena regioner och städer, där regionerna definieras av politiska geografiska enheter, inbegripet suveräna stater, subnationella administrativa områden och multinationella grupperingar, och städer beskrivs som stora bosättningar."@sv;
        skos:definition     "téama tacair sonraí lena gcumhdaítear réimse na réigiún agus réimse na gcathracha, agus na réigiúin arna sainiú de réir aonaid tíreolaíochta polaitiúla lena n-áirítear stáit cheannasacha, limistéir riaracháin fhonáisiúnta, agus grúpálacha ilnáisiúnta, agus na cathracha arna sainiú de réir na saintréithe atá acu mar lonnaíochtaí móra daonna"@ga;
        skos:definition     "temat zbioru danych obejmujący dziedziny dotyczące regionów i miast, gdzie regiony są definiowane jako geograficzne jednostki polityczne, w tym suwerenne państwa, obszary administracyjne na szczeblu niższym niż krajowy, grupy wielonarodowe, a miasta definiuje się jako duże osiedla ludzkie"@pl;
        skos:definition     "tema ta’ sett tad-data li tkopri l-oqsma tar-reġjuni u l-bliet, fejn ir-reġjuni huma definiti minn unitajiet ġeografiċi politiċi inklużi stati sovrani, żoni amministrattivi sottonazzjonali, u raggruppamenti multinazzjonali, u fejn il-bliet huma definiti bħala insedjamenti umani kbar"@mt;
        skos:inScheme       atold:data-theme;
