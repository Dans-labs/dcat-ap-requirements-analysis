<data-theme/1b1aacae81728abca5543ab2e7e8b52b>
        rdf:type         euvoc:XlNote;
        rdf:type         euvoc:XlNote;
        euvoc:startDate  "2015-10-01"^^<http://www.w3.org/2001/XMLSchema#date>;
        dct:created      "2024-05-22"^^<http://www.w3.org/2001/XMLSchema#date>;
        rdf:value        "тема на множество от данни, обхващаща областите на регионите и градовете; регионите са определени от политическата география единици, включващи суверенните държави, поднационалните административни подразделения и многонационалните обединения; градовете се определят като големи човешки поселища"@bg;
        dct:creator      "Publications Office of the European Union";
        euvoc:xlNote     "тема на множество от данни, обхващаща областите на регионите и градовете; регионите са определени от политическата география единици, включващи суверенните държави, поднационалните административни подразделения и многонационалните обединения; градовете се определят като големи човешки поселища"@bg .

<data-theme/ee3cc9012449792645dbaeb2e8d9cdf8>
        rdf:type         euvoc:XlNote;
        rdf:type         euvoc:XlNote;
        euvoc:startDate  "2015-10-01"^^<http://www.w3.org/2001/XMLSchema#date>;
        dct:created      "2024-05-22"^^<http://www.w3.org/2001/XMLSchema#date>;
        rdf:value        "tietojoukkoryhmä, joka kattaa alueiden ja kaupunkien alat: alueet määritellään poliittisiksi maantieteellisiksi yksiköksi, joihin kuuluu suvereeneja valtioita, valtiotasoa alempia hallintoalueita ja monikansallisia ryhmittymiä, ja kaupunkeja voidaan pitää suurina asuinyhdyskuntina"@fi;
        dct:creator      "Publications Office of the European Union";
        euvoc:xlNote     "tietojoukkoryhmä, joka kattaa alueiden ja kaupunkien alat: alueet määritellään poliittisiksi maantieteellisiksi yksiköksi, joihin kuuluu suvereeneja valtioita, valtiotasoa alempia hallintoalueita ja monikansallisia ryhmittymiä, ja kaupunkeja voidaan pitää suurina asuinyhdyskuntina"@fi .

<data-theme/7bf2f293ecb70344bca07fa450cafee5>
        rdf:type         euvoc:XlNote;
        rdf:type         euvoc:XlNote;
        euvoc:startDate  "2015-10-01"^^<http://www.w3.org/2001/XMLSchema#date>;
        dct:created      "2024-05-22"^^<http://www.w3.org/2001/XMLSchema#date>;
        rdf:value        "dataset theme covering the domains of regions and cities, where regions is defined by political geography units including sovereign states, subnational administrative areas, and multinational groupings, and cities are characterised as large human settlements"@en;
        dct:creator      "Publications Office of the European Union";
        euvoc:xlNote     "dataset theme covering the domains of regions and cities, where regions is defined by political geography units including sovereign states, subnational administrative areas, and multinational groupings, and cities are characterised as large human settlements"@en .

<data-theme/643b375002a0905c2d7a584add3a18b3>
        rdf:type         euvoc:XlNote;
        rdf:type         euvoc:XlNote;
        euvoc:startDate  "2015-10-01"^^<http://www.w3.org/2001/XMLSchema#date>;
        dct:created      "2024-05-22"^^<http://www.w3.org/2001/XMLSchema#date>;
        rdf:value        "tema di serie di dati relativo ai settori delle regioni e delle città, ove per regioni si intendono unità geografiche e politiche tra cui rientrano gli stati sovrani, le unità amministrative subnazionali e i raggruppamenti multinazionali, mentre le città sono definite come ampi insediamenti umani"@it;
        dct:creator      "Publications Office of the European Union";
        euvoc:xlNote     "tema di serie di dati relativo ai settori delle regioni e delle città, ove per regioni si intendono unità geografiche e politiche tra cui rientrano gli stati sovrani, le unità amministrative subnazionali e i raggruppamenti multinazionali, mentre le città sono definite come ampi insediamenti umani"@it .

<data-theme/c5c77ff2e948ac80f57f878bf7e1aa68>
        rdf:type         euvoc:XlNote;
        rdf:type         euvoc:XlNote;
        euvoc:startDate  "2015-10-01"^^<http://www.w3.org/2001/XMLSchema#date>;
        dct:created      "2024-05-22"^^<http://www.w3.org/2001/XMLSchema#date>;
        rdf:value        "dataset för områdena regioner och städer, där regionerna definieras av politiska geografiska enheter, inbegripet suveräna stater, subnationella administrativa områden och multinationella grupperingar, och städer beskrivs som stora bosättningar."@sv;
        dct:creator      "Publications Office of the European Union";
        euvoc:xlNote     "dataset för områdena regioner och städer, där regionerna definieras av politiska geografiska enheter, inbegripet suveräna stater, subnationella administrativa områden och multinationella grupperingar, och städer beskrivs som stora bosättningar."@sv .

<data-theme/e27f71b34a7ef3b8a1257c7bb97ac1be>
        rdf:type         euvoc:XlNote;
        rdf:type         euvoc:XlNote;
        euvoc:startDate  "2015-10-01"^^<http://www.w3.org/2001/XMLSchema#date>;
        dct:created      "2024-05-22"^^<http://www.w3.org/2001/XMLSchema#date>;
        rdf:value        "andmestike teema, mis hõlmab selliseid valdkondi nagu piirkonnad ja linnad, kui piirkond on määratletud kui poliitgeograafia üksus ja hõlmab suveräänseid riike, riigi tasandist madalamale tasandil olevaid halduspiirkondi ja rahvusvahelisi rühmi, ning linnade puhul on tegu suurte asulatega"@et;
        dct:creator      "Publications Office of the European Union";
        euvoc:xlNote     "andmestike teema, mis hõlmab selliseid valdkondi nagu piirkonnad ja linnad, kui piirkond on määratletud kui poliitgeograafia üksus ja hõlmab suveräänseid riike, riigi tasandist madalamale tasandil olevaid halduspiirkondi ja rahvusvahelisi rühmi, ning linnade puhul on tegu suurte asulatega"@et .

<data-theme/631af31d5c1b0772d0699055684f119a>
        rdf:type         euvoc:XlNote;
        rdf:type         euvoc:XlNote;
        euvoc:startDate  "2015-10-01"^^<http://www.w3.org/2001/XMLSchema#date>;
        dct:created      "2024-05-22"^^<http://www.w3.org/2001/XMLSchema#date>;
        rdf:value        "podatkovni nabor, ki pokriva področji regij in mest, pri čemer so regije opredeljene kot politične geografske enote, vključno s suverenimi državami, podnacionalnimi upravnimi enotami in večnacionalnimi združbami, medtem ko so za mesta značilna velike človeške naselbine"@sl;
        dct:creator      "Publications Office of the European Union";
        euvoc:xlNote     "podatkovni nabor, ki pokriva področji regij in mest, pri čemer so regije opredeljene kot politične geografske enote, vključno s suverenimi državami, podnacionalnimi upravnimi enotami in večnacionalnimi združbami, medtem ko so za mesta značilna velike človeške naselbine"@sl .

<data-theme/89d40be1ed07b28e66e2846408ca50b0>
        rdf:type         euvoc:XlNote;
        rdf:type         euvoc:XlNote;
        euvoc:startDate  "2015-10-01"^^<http://www.w3.org/2001/XMLSchema#date>;
        dct:created      "2024-05-22"^^<http://www.w3.org/2001/XMLSchema#date>;
        rdf:value        "thème d’un ensemble de données couvrant les domaines des régions et des villes, les régions étant définies par des unités de géographie politique, dont les États souverains, les zones administratives infranationales et les groupements multinationaux, et les villes étant définies comme de grands établissements humains"@fr;
        dct:creator      "Publications Office of the European Union";
        euvoc:xlNote     "thème d’un ensemble de données couvrant les domaines des régions et des villes, les régions étant définies par des unités de géographie politique, dont les États souverains, les zones administratives infranationales et les groupements multinationaux, et les villes étant définies comme de grands établissements humains"@fr .

<data-theme/f9a8fa52395e37884759295b4b2dbeb5>
        rdf:type         euvoc:XlNote;
        rdf:type         euvoc:XlNote;
        euvoc:startDate  "2015-10-01"^^<http://www.w3.org/2001/XMLSchema#date>;
        dct:created      "2024-05-22"^^<http://www.w3.org/2001/XMLSchema#date>;
        rdf:value        "tema setului de date care vizează domeniile regiunilor și orașelor, în care regiunile sunt definite de unități geografice politice, inclusiv de state suverane, zone administrative subnaționale și grupări multinaționale, iar orașele sunt caracterizate ca așezări omenești mari"@ro;
        dct:creator      "Publications Office of the European Union";
        euvoc:xlNote     "tema setului de date care vizează domeniile regiunilor și orașelor, în care regiunile sunt definite de unități geografice politice, inclusiv de state suverane, zone administrative subnaționale și grupări multinaționale, iar orașele sunt caracterizate ca așezări omenești mari"@ro .

<data-theme/a5707f4af1b61ea58deb0dfa7bc8b925>
        rdf:type         euvoc:XlNote;
        rdf:type         euvoc:XlNote;
        euvoc:startDate  "2015-10-01"^^<http://www.w3.org/2001/XMLSchema#date>;
        dct:created      "2024-05-22"^^<http://www.w3.org/2001/XMLSchema#date>;
        rdf:value        "datu kopa, kas aptver tādas jomas kā reģioni un pilsētas, kur reģionus definē pēc politiski ģeogrāfiskām vienībām, tostarp suverēnām valstīm, vietējām administratīvajām teritorijām un daudznacionāliem grupējumiem, bet pilsētas raksturojamas kā lielas apdzīvotas vietas"@lv;
        dct:creator      "Publications Office of the European Union";
        euvoc:xlNote     "datu kopa, kas aptver tādas jomas kā reģioni un pilsētas, kur reģionus definē pēc politiski ģeogrāfiskām vienībām, tostarp suverēnām valstīm, vietējām administratīvajām teritorijām un daudznacionāliem grupējumiem, bet pilsētas raksturojamas kā lielas apdzīvotas vietas"@lv .

<data-theme/3918b2f469980e799a69b8c4de5a4251>
        rdf:type         euvoc:XlNote;
        rdf:type         euvoc:XlNote;
