<data-theme/cc9e274c29f19dc9c95267c6dc4016ed>
        rdf:type         euvoc:XlNote;
        rdf:type         euvoc:XlNote;
        euvoc:startDate  "2015-10-01"^^<http://www.w3.org/2001/XMLSchema#date>;
        dct:created      "2024-05-22"^^<http://www.w3.org/2001/XMLSchema#date>;
        rdf:value        "tema di serie di dati relativo ai settori dell'agricoltura, che comprende la coltivazione di piante e l'allevamento di animali; della pesca, incentrata sul prelievo di pesci selvatici o di allevamento; della silvicoltura, che riguarda la gestione e la conservazione delle foreste e dei boschi; e degli alimenti, in cui rientrano le sostanze che forniscono sostegno nutrizionale agli organismi"@it;
        dct:creator      "Publications Office of the European Union";
        euvoc:xlNote     "tema di serie di dati relativo ai settori dell'agricoltura, che comprende la coltivazione di piante e l'allevamento di animali; della pesca, incentrata sul prelievo di pesci selvatici o di allevamento; della silvicoltura, che riguarda la gestione e la conservazione delle foreste e dei boschi; e degli alimenti, in cui rientrano le sostanze che forniscono sostegno nutrizionale agli organismi"@it .

