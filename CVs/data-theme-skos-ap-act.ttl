        euvoc:xlDefinition  <data-theme/d496d1f52a178c5e06ca56f115c6efb4>;
        euvoc:xlDefinition  <data-theme/9c62d40a4e86490e8a699f038f19e5a6>;
        euvoc:xlDefinition  <data-theme/832e84c82f01667e2e0ecdee85fa0f4c>;
        euvoc:xlDefinition  <data-theme/6f948adc0e6127238258270fb2885a7b>;
        euvoc:xlDefinition  <data-theme/7f99870dc487a115f6e552728b130315>;
        euvoc:xlDefinition  <data-theme/3b7fb03898715e47bc6402151c6365cf>;
        euvoc:xlDefinition  <data-theme/55799f46fd53b6c1348372754dc562d6>;
        euvoc:xlDefinition  <data-theme/75ceeedded2a26f4670aabd60c0a71e4>;
        euvoc:xlDefinition  <data-theme/a892c9ea3742dbad86555513980d646f>;
        euvoc:xlDefinition  <data-theme/327c437a30ccc2667820c16223bd8073>;
        euvoc:xlDefinition  <data-theme/7c823d14a3cc5a5243e04c0727bac193>;
        euvoc:xlDefinition  <data-theme/be6402c4cf67b0711926d1da6ed04d13>;
        euvoc:xlDefinition  <data-theme/54954df0706802408b3833dca78cca9a>;
        euvoc:xlDefinition  <data-theme/037831c90959775a3f64617e68478c59>;
        euvoc:xlDefinition  <data-theme/866910bde7ec73c0a60e315a3f5982ef>;
        euvoc:xlDefinition  <data-theme/505bb009b07575c236fa9abc7504fc1d>;
        euvoc:xlDefinition  <data-theme/b74277fb6d89f37739486decff78430d>;
        euvoc:xlDefinition  <data-theme/aa4652f7f891453d78ca948c389b26d6>;
        dct:dateAccepted    "2015-10-09"^^<http://www.w3.org/2001/XMLSchema#date>;
        dct:dateSubmitted   "2015-10-09"^^<http://www.w3.org/2001/XMLSchema#date>;
        owl:versionInfo     "20241211-0";
        skos:definition     "tema de un conjunto de datos que abarca el ámbito de la energía, definida como la propiedad cuantitativa necesaria para efectuar trabajos sobre objetos o para aumentar la temperatura de estos, y como un elemento vital para los organismos vivos y para el funcionamiento de la civilización humana"@es;
        skos:definition     "tema ta’ sett ta’ data li tkopri d-dominju tal-enerġija, definita bħala l-proprjetà kwantitattiva meħtieġa biex jiġi eżegwit xogħol fuq oġġetti jew biex dawn jissaħħnu, u bħala l-element vitali għall-organiżmi ħajjin u għall-funzjonament taċ-ċiviltà umana"@mt;
        skos:definition     "Az energia területére kiterjedő adatkészlet-téma, ahol az energia munka vagy hő létrehozásához szükséges kvantitatív jellemző, valamint az élő szervezetek és az emberi civilizáció működésének létfontosságú eleme."@hu;
        skos:definition     "téma dátového súboru pokrývajúca oblasť energetiky, ktorá je charakterizovaná ako kvantitatívna vlastnosť potrebná na výkon práce na objektoch alebo na ich ohrievanie a nevyhnutná pre život organizmov a fungovanie ľudskej civilizácie"@sk;
        skos:definition     "conjunto de dados cujo tema abrange o domínio da energia, caracterizada como a propriedade quantitativa necessária para executar trabalhos sobre objetos ou aquecer objetos, enquanto elemento vital para os organismos vivos e para o funcionamento da civilização humana"@pt;
        skos:definition     "datu kopa, kura aptver enerģētikas jomu, kas raksturojama kā kvantitatīva īpašība, kas vajadzīga, lai veiktu darbu ar priekšmetiem vai tos apsildītu, un kas ietver dzīvu organismu dzīvības elementu un cilvēku civilizācijas darbību"@lv;
        skos:definition     "temat zbioru danych obejmujący dziedzinę energii, zdefiniowaną jako właściwość ilościowa niezbędna do wykonywania prac na przedmiotach lub do ich ogrzewania oraz jako istotny element żywych organizmów i działalności cywilizacji ludzkiej"@pl;
        skos:definition     "tema for datasæt, som vedrører området energi, karakteriseret som den kvantitative egenskab, der er nødvendig for at udføre arbejde på eller opvarme genstande, og et vitalt element for levende organismer og den menneskelige civilisations funktion"@da;
        skos:definition     "thème d’un ensemble de données couvrant le domaine de l’énergie, définie comme la propriété quantitative nécessaire pour effectuer un travail sur l’objet ou pour le chauffer, et comme un élément vital pour les organismes vivants et le fonctionnement de la civilisation humaine"@fr;
        skos:definition     "тема на множество от данни, обхващаща областта на енергията, която представлява количественото свойство, необходимо за извършване на работа върху предмети или за загряването им, и жизненоважен елемент за живите организми, както и осъществяването на човешката цивилизация"@bg;
        skos:definition     "tema podatkovnog skupa koja obuhvaća domenu energije, što je količinsko svojstvo nužno za izvođenje radova na predmetima ili za njihovo grijanje, i neophodna je za žive organizme i funkcioniranje ljudske civilizacije"@hr;
        skos:definition     "θέμα συνόλου δεδομένων το οποίο καλύπτει τον τομέα της ενέργειας που χαρακτηρίζεται ως το ποσοτικό χαρακτηριστικό που απαιτείται για την εκτέλεση εργασιών σε αντικείμενα ή τη θέρμανση αντικειμένων, και ζωτικό στοιχείο των ζώντων οργανισμών και της λειτουργίας του ανθρώπινου πολιτισμού"@el;
        skos:definition     "dataset för området energi, som är förmågan att utföra arbete eller avge värme, och som är en förutsättning för levande organismer och den mänskliga civilisationen."@sv;
        skos:definition     "datasetthema dat betrekking heeft op het domein energie, gekarakteriseerd als de kwantitatieve eigenschap die nodig is voor het bewerken of verwarmen van objecten, en die een vitaal element vormt van levende organismen en voor de werking van de menselijke beschaving"@nl;
        skos:definition     "Datensatzthema für den Bereich Energie, bei der es sich um die quantitative Eigenschaft handelt, die notwendig ist, um Arbeit an Gegenständen zu verrichten oder diese zu erwärmen, und die unerlässlich für das Leben von Organismen und das Funktionieren einer menschlichen Zivilisation ist"@de;
        skos:definition     "tietojoukkoryhmä, joka kattaa energia-alan, jota voidaan pitää kohteiden työstämisen tai niiden lämmittämisen edellyttämänä määrällisenä ominaisuutena sekä elävien organismien ja ihmiskunnan toiminnan elinehtona"@fi;
        skos:definition     "dataset theme covering the domain of energy, characterised as the quantitative property necessary to perform work on or heat objects, and vital element of living organisms and the operation of human civilisation"@en;
        skos:definition     "téma datového souboru týkající se oblasti energie, charakterizované jako kvantitativní vlastnost nezbytná k výkonu práce na tělesech nebo k ohřevu těles a jako prvek se zásadním významem pro živé organismy a pro fungování lidské civilizace"@cs;
        skos:definition     "téama tacair sonraí lena gcumhdaítear réimse an fhuinnimh, arb é is saintréith dó an t-airí cainníochtúil atá riachtanach chun oibriú ar réada nó chun réada a théamh, agus atá ina ghné bhunthábhachtach d’orgánaigh bheo agus d’oibriú na sibhialtachta daonna"@ga;
        skos:definition     "duomenų rinkinio tema, apimanti tokią sritį kaip energetika, kuri apibūdinama kaip kiekybinė savybė, būtina darbui atlikti arba objektams šildyti, ir yra gyvybiškai svarbus gyvųjų organizmų ir žmogaus civilizacijos veikimo elementas"@lt;
        skos:definition     "tema setului de date care vizează domeniul energiei, caracterizată ca fiind proprietatea cantitativă necesară exercitării unor acțiuni asupra obiectelor sau încălzirii obiectelor și totodată elementul vital al organismelor vii și al funcționării civilizației umane"@ro;
        skos:definition     "andmestike teema, mis hõlmab sellist valdkonda nagu energia/energeetika; oma olemuselt on energia töö sooritamiseks või objektide soojendamiseks vajalik kvantitatiivne omadus, mis kujutab enesest keskset elementi elusorganismide jaoks ja tsivilisatsiooni funktsioneerimise seisukohast"@et;
        skos:definition     "podatkovni nabor, ki pokriva področje energije, ki je količinska lastnost, potrebna za delo na predmetih ali njihovo segrevanje, ter nepogrešljiva za žive organizme in delovanje človeške civilizacije"@sl;
        skos:definition     "tema di serie di dati relativo al settore dell'energia, descritta come la capacità di un corpo di compiere lavoro o di trasferire calore e che è l'elemento vitale per gli organismi viventi e il funzionamento della società umana"@it;
        skos:inScheme       atold:data-theme;
