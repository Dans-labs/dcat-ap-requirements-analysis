   <euvoc:XlNote rdf:about="http://publications.europa.eu/resource/authority/data-theme/73cf9d0f17d58805883728b5fc67a12b">
      <rdf:type rdf:resource="http://publications.europa.eu/ontology/euvoc#XlNote"/>
      <euvoc:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2015-10-01</euvoc:startDate>
      <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-22</dct:created>
      <rdf:value xml:lang="pl">temat zbioru danych obejmujący dziedzinę zagadnień międzynarodowych dotyczącą istotnych tematów lub problemów będących przedmiotem debaty lub dyskusji z udziałem uczestników z co najmniej dwóch różnych krajów</rdf:value>
      <dct:creator>Publications Office of the European Union</dct:creator>
