      <rdf:value xml:lang="en">dataset theme covering the domain of international issues which relates to significant topics or problems that are subject to debate or discussion and involve participants from at least two different countries</rdf:value>
      <dct:creator>Publications Office of the European Union</dct:creator>
      <euvoc:xlNote xml:lang="en">dataset theme covering the domain of international issues which relates to significant topics or problems that are subject to debate or discussion and involve participants from at least two different countries</euvoc:xlNote>
   </euvoc:XlNote>
   <euvoc:XlNote rdf:about="http://publications.europa.eu/resource/authority/data-theme/ded8db691b769936fefb3d1c19b3e85d">
      <rdf:type rdf:resource="http://publications.europa.eu/ontology/euvoc#XlNote"/>
