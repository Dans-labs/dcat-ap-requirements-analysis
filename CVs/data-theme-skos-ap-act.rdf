   <euvoc:XlNote rdf:about="http://publications.europa.eu/resource/authority/data-theme/d134057a8c837b6b780fd353fc6d6a1f">
      <rdf:type rdf:resource="http://publications.europa.eu/ontology/euvoc#XlNote"/>
