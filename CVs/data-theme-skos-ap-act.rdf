   </euvoc:XlNote>
   <euvoc:XlNote rdf:about="http://publications.europa.eu/resource/authority/data-theme/c3f8fd3d493138dd0125cf0604756a6c">
      <rdf:type rdf:resource="http://publications.europa.eu/ontology/euvoc#XlNote"/>
