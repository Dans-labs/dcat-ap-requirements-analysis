      <rdf:value xml:lang="fi">tietojoukkoryhmä, joka kattaa sellaiset taloudellisen toiminnan alat, jotka liittyvät tavaroiden ja palveluiden tuotantoon, jakeluun, kauppaan ja kulutukseen, sekä sellaiset rahoitustoiminnan alat, jotka keskittyvät varainhoitoon henkilö-, yritys- tai hallintotasolla</rdf:value>
      <dct:creator>Publications Office of the European Union</dct:creator>
      <euvoc:xlNote xml:lang="fi">tietojoukkoryhmä, joka kattaa sellaiset taloudellisen toiminnan alat, jotka liittyvät tavaroiden ja palveluiden tuotantoon, jakeluun, kauppaan ja kulutukseen, sekä sellaiset rahoitustoiminnan alat, jotka keskittyvät varainhoitoon henkilö-, yritys- tai hallintotasolla</euvoc:xlNote>
   </euvoc:XlNote>
   <euvoc:XlNote rdf:about="http://publications.europa.eu/resource/authority/data-theme/6bf98258921f77fd4b9de96ade361a48">
      <rdf:type rdf:resource="http://publications.europa.eu/ontology/euvoc#XlNote"/>
