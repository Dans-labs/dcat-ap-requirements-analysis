   <euvoc:XlNote rdf:about="http://publications.europa.eu/resource/authority/data-theme/0befbedbcefe62893c8d84809d2fb56d">
      <rdf:type rdf:resource="http://publications.europa.eu/ontology/euvoc#XlNote"/>
