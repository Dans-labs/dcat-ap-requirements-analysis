      <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-11-24</dct:created>
      <dct:type rdf:resource="http://publications.europa.eu/resource/authority/label-type/STANDARDLABEL"/>
      <skos-xl:literalForm xml:lang="fr">Données provisoires</skos-xl:literalForm>
      <rdfs:label xml:lang="fr">Données provisoires</rdfs:label>
   </skos-xl:Label>
   <skos-xl:Label rdf:about="http://publications.europa.eu/resource/authority/data-theme/label_9a539e45a7347b8e692520777c6ea954">
      <rdf:type rdf:resource="http://www.w3.org/2008/05/skos-xl#Label"/>
      <euvoc:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">1952-07-23</euvoc:startDate>
      <euvoc:status rdf:resource="http://publications.europa.eu/resource/authority/concept-status/CURRENT"/>
      <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-11-24</dct:created>
