      <rdf:value xml:lang="sk">téma dátového súboru pokrývajúca oblasť dopravy, ktorá zahŕňa pohyb ľudí, zvierat a tovaru z jedného miesta na druhé s použitím rôznych druhov dopravy, ako je letecká, pozemná (železničná a cestná), vodná, lanová, potrubná a vesmírna doprava</rdf:value>
      <dct:creator>Publications Office of the European Union</dct:creator>
