   <euvoc:XlNote rdf:about="http://publications.europa.eu/resource/authority/data-theme/0d9f1a53e6233e8a0bc72654e9fe9d14">
      <rdf:type rdf:resource="http://publications.europa.eu/ontology/euvoc#XlNote"/>
