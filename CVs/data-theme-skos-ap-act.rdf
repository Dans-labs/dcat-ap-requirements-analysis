      <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-22</dct:created>
      <rdf:value xml:lang="hr">tema podatkovnog skupa koja obuhvaća domenu međunarodnih pitanja koja se odnosi na važne teme ili pitanja o kojima raspravljaju ili ih razmatraju sudionici iz barem dvije države</rdf:value>
      <dct:creator>Publications Office of the European Union</dct:creator>
