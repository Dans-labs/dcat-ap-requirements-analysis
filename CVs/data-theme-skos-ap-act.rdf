      <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-22</dct:created>
      <rdf:value xml:lang="sl">podatkovni nabor, ki pokriva področje mednarodnih vprašanj, ki se nanašajo na različne teme ali probleme, ki so predmet razprav ali posvetovanj, pri katerih sodelujejo udeleženci iz najmanj dveh različnih držav</rdf:value>
      <dct:creator>Publications Office of the European Union</dct:creator>
      <euvoc:xlNote xml:lang="sl">podatkovni nabor, ki pokriva področje mednarodnih vprašanj, ki se nanašajo na različne teme ali probleme, ki so predmet razprav ali posvetovanj, pri katerih sodelujejo udeleženci iz najmanj dveh različnih držav</euvoc:xlNote>
