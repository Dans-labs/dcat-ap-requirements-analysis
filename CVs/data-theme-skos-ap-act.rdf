   <euvoc:XlNote rdf:about="http://publications.europa.eu/resource/authority/data-theme/7783df6a4ead36b978690ae87cd70e01">
      <rdf:type rdf:resource="http://publications.europa.eu/ontology/euvoc#XlNote"/>
