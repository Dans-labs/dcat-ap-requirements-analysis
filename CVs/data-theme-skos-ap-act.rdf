   </euvoc:XlNote>
   <euvoc:XlNote rdf:about="http://publications.europa.eu/resource/authority/data-theme/7076d0588815eeecca5a8da8565b7e22">
      <rdf:type rdf:resource="http://publications.europa.eu/ontology/euvoc#XlNote"/>
