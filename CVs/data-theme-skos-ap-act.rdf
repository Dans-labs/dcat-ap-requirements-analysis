   <euvoc:XlNote rdf:about="http://publications.europa.eu/resource/authority/data-theme/0b2f40c7523f72413956da94e8ff3952">
      <rdf:type rdf:resource="http://publications.europa.eu/ontology/euvoc#XlNote"/>
      <euvoc:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2015-10-01</euvoc:startDate>
      <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-22</dct:created>
      <rdf:value xml:lang="mt">tema ta’ sett tad-data li tkopri l-oqsma tal-edukazzjoni li tiffaċilita t-tagħlim u l-kisba tal-għarfien, il-ħiliet, il-valuri, it-twemmin, u l-abitudnijiet; il-kultura, li tinkludi l-imġiba soċjali, in-normi, l-għarfien, it-twemmin, l-arti, il-liġijiet, id-drawwiet, il-kapaċitajiet, u l-abitudnijiet li jinsabu fis-soċjetajiet umani; u l-isport, li jinkludi attivitajiet fiżiċi kompetittivi jew logħob li jtejjeb il-kapaċità fiżika u l-ħiliet, u li jipprovdi kemm gost lill-parteċipanti kif ukoll divertiment lill-ispettaturi</rdf:value>
      <dct:creator>Publications Office of the European Union</dct:creator>
      <euvoc:xlNote xml:lang="mt">tema ta’ sett tad-data li tkopri l-oqsma tal-edukazzjoni li tiffaċilita t-tagħlim u l-kisba tal-għarfien, il-ħiliet, il-valuri, it-twemmin, u l-abitudnijiet; il-kultura, li tinkludi l-imġiba soċjali, in-normi, l-għarfien, it-twemmin, l-arti, il-liġijiet, id-drawwiet, il-kapaċitajiet, u l-abitudnijiet li jinsabu fis-soċjetajiet umani; u l-isport, li jinkludi attivitajiet fiżiċi kompetittivi jew logħob li jtejjeb il-kapaċità fiżika u l-ħiliet, u li jipprovdi kemm gost lill-parteċipanti kif ukoll divertiment lill-ispettaturi</euvoc:xlNote>
   </euvoc:XlNote>
