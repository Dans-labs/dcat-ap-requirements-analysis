   <euvoc:XlNote rdf:about="http://publications.europa.eu/resource/authority/data-theme/5c2184cb07318f99949e4444ddc5ac68">
      <rdf:type rdf:resource="http://publications.europa.eu/ontology/euvoc#XlNote"/>
