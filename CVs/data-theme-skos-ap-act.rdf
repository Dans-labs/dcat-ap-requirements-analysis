      <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-22</dct:created>
      <rdf:value xml:lang="fr">thème d’un ensemble de données couvrant le domaine des questions internationales qui se rapportent à des sujets ou à des problèmes importants faisant l’objet d’un débat ou d’une discussion et associant des participants d’au moins deux pays différents</rdf:value>
      <dct:creator>Publications Office of the European Union</dct:creator>
