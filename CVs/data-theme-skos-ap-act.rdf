      <skos:prefLabel xml:lang="it">Giustizia, sistema giuridico e sicurezza pubblica</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Ġustizzja, sistema legali u sigurtà pubblika</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">Sprawiedliwość, ustrój sądów i bezpieczeństwo publiczne</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">Tieslietas, tiesību sistēma un sabiedrības drošība</skos:prefLabel>
