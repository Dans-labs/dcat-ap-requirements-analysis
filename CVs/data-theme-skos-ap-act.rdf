   <euvoc:XlNote rdf:about="http://publications.europa.eu/resource/authority/data-theme/87b79b4d1eb4a2ebc5c3cecd52f3f2d5">
      <rdf:type rdf:resource="http://publications.europa.eu/ontology/euvoc#XlNote"/>
