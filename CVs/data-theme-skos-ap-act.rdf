      <skos:prefLabel xml:lang="hu">Igazságügy, jogrendszer és közbiztonság</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Ceartas, córas dlí agus sábháilteacht an phobail</skos:prefLabel>
      <skos:prefLabel xml:lang="et">Õigusemõistmine, õigussüsteem ja avalik turvalisus</skos:prefLabel>
