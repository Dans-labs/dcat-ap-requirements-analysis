   <euvoc:XlNote rdf:about="http://publications.europa.eu/resource/authority/data-theme/d46e778aa48c0eb2020b42dbb90ab1da">
      <rdf:type rdf:resource="http://publications.europa.eu/ontology/euvoc#XlNote"/>
      <euvoc:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2015-10-01</euvoc:startDate>
      <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-22</dct:created>
      <rdf:value xml:lang="lv">datu kopa, kas aptver tādas jomas kā iedzīvotāji un sabiedrība, kur ar iedzīvotājiem saprot to cilvēku kopskaitu, kuri dzīvo dažādos ģeogrāfiskajos līmeņos, sākot no pilsētām līdz pasaules mērogam, bet ar sabiedrību –– to personu grupu, kura iesaistīta nepārtrauktā sociālā mijiedarbībā kādā kopējā teritorijā un kura bieži vien ir pieņēmusi un ievēro vienas un tās pašas politiskās un kultūras normas</rdf:value>
      <dct:creator>Publications Office of the European Union</dct:creator>
      <euvoc:xlNote xml:lang="lv">datu kopa, kas aptver tādas jomas kā iedzīvotāji un sabiedrība, kur ar iedzīvotājiem saprot to cilvēku kopskaitu, kuri dzīvo dažādos ģeogrāfiskajos līmeņos, sākot no pilsētām līdz pasaules mērogam, bet ar sabiedrību –– to personu grupu, kura iesaistīta nepārtrauktā sociālā mijiedarbībā kādā kopējā teritorijā un kura bieži vien ir pieņēmusi un ievēro vienas un tās pašas politiskās un kultūras normas</euvoc:xlNote>
   </euvoc:XlNote>
