   <euvoc:XlNote rdf:about="http://publications.europa.eu/resource/authority/data-theme/9bdc6271550c3271d7ffce14a31ad52a">
      <rdf:type rdf:resource="http://publications.europa.eu/ontology/euvoc#XlNote"/>
      <euvoc:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2015-10-01</euvoc:startDate>
      <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-22</dct:created>
      <rdf:value xml:lang="it">tema di serie di dati relativo al settore delle tematiche internazionali riguardante argomenti significativi o problemi oggetto di dibattiti o discussioni che coinvolgono partecipanti di almeno due paesi diversi</rdf:value>
      <dct:creator>Publications Office of the European Union</dct:creator>
      <euvoc:xlNote xml:lang="it">tema di serie di dati relativo al settore delle tematiche internazionali riguardante argomenti significativi o problemi oggetto di dibattiti o discussioni che coinvolgono partecipanti di almeno due paesi diversi</euvoc:xlNote>
   </euvoc:XlNote>
   <euvoc:XlNote rdf:about="http://publications.europa.eu/resource/authority/data-theme/ef40cb7dd0f340c27a515f369e5a7048">
      <rdf:type rdf:resource="http://publications.europa.eu/ontology/euvoc#XlNote"/>
      <euvoc:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2015-10-01</euvoc:startDate>
      <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-22</dct:created>
      <rdf:value xml:lang="el">θέμα συνόλου δεδομένων το οποίο καλύπτει τον τομέα διεθνών θεμάτων και αφορά σημαντικά ζητήματα ή προβλήματα που αποτελούν αντικείμενο συζήτησης, με συμμετέχοντες από τουλάχιστον δύο διαφορετικές χώρες</rdf:value>
      <dct:creator>Publications Office of the European Union</dct:creator>
      <euvoc:xlNote xml:lang="el">θέμα συνόλου δεδομένων το οποίο καλύπτει τον τομέα διεθνών θεμάτων και αφορά σημαντικά ζητήματα ή προβλήματα που αποτελούν αντικείμενο συζήτησης, με συμμετέχοντες από τουλάχιστον δύο διαφορετικές χώρες</euvoc:xlNote>
   </euvoc:XlNote>
   <euvoc:XlNote rdf:about="http://publications.europa.eu/resource/authority/data-theme/6ee5eeb2ec2fe38b09c82a22e18105f9">
      <rdf:type rdf:resource="http://publications.europa.eu/ontology/euvoc#XlNote"/>
      <euvoc:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2015-10-01</euvoc:startDate>
      <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-22</dct:created>
      <rdf:value xml:lang="sk">téma dátového súboru pokrývajúca oblasť medzinárodných otázok týkajúcich sa významných tém alebo problémov, ktoré sú predmetom debát alebo diskusií a do ktorých sú zapojení účastníci z najmenej dvoch rôznych krajín</rdf:value>
      <dct:creator>Publications Office of the European Union</dct:creator>
      <euvoc:xlNote xml:lang="sk">téma dátového súboru pokrývajúca oblasť medzinárodných otázok týkajúcich sa významných tém alebo problémov, ktoré sú predmetom debát alebo diskusií a do ktorých sú zapojení účastníci z najmenej dvoch rôznych krajín</euvoc:xlNote>
   </euvoc:XlNote>
   <euvoc:XlNote rdf:about="http://publications.europa.eu/resource/authority/data-theme/42674f5fc16f916f553e5da8b4c843f2">
      <rdf:type rdf:resource="http://publications.europa.eu/ontology/euvoc#XlNote"/>
      <euvoc:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2015-10-01</euvoc:startDate>
      <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-22</dct:created>
      <rdf:value xml:lang="cs">téma datového souboru týkající se oblasti mezinárodních otázek, která se vztahuje na významná témata nebo problémy, o nichž se vede debata nebo diskuse s účastníky z nejméně dvou různých zemí</rdf:value>
      <dct:creator>Publications Office of the European Union</dct:creator>
      <euvoc:xlNote xml:lang="cs">téma datového souboru týkající se oblasti mezinárodních otázek, která se vztahuje na významná témata nebo problémy, o nichž se vede debata nebo diskuse s účastníky z nejméně dvou různých zemí</euvoc:xlNote>
   </euvoc:XlNote>
   <euvoc:XlNote rdf:about="http://publications.europa.eu/resource/authority/data-theme/451d94656aa95aea4255769b019c4e3c">
      <rdf:type rdf:resource="http://publications.europa.eu/ontology/euvoc#XlNote"/>
      <euvoc:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2015-10-01</euvoc:startDate>
