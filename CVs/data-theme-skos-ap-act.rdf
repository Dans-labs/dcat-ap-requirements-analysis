      <euvoc:xlNote xml:lang="it">tema di serie di dati relativo ai settori dell'attività economica, che riguarda la produzione, la distribuzione, gli scambi e il consumo di beni e servizi, e dell'attività finanziaria, che è incentrata sulla gestione del denaro a livello individuale, aziendale o di governo</euvoc:xlNote>
   </euvoc:XlNote>
   <euvoc:XlNote rdf:about="http://publications.europa.eu/resource/authority/data-theme/f9b97f4397da84b6fa0a7e56943de121">
      <rdf:type rdf:resource="http://publications.europa.eu/ontology/euvoc#XlNote"/>
